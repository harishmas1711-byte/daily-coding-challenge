1.class Solution {
    public int[] numberOfLines(int[] widths, String s) {
        char c[]=s.toCharArray();
        int sum=0,l=0,px=0;
        int res[]=new int [2];
        for(char k:c){
            int r=k-'a';
            if(sum+widths[r]>100){
                sum=0;
                l++;
            }
            sum+=widths[r];
        }
        if(sum!=0) res[0]=l+1;
        else res[0]=l;
        res[1]=sum;
        return res;
    }
}
2.class Solution {
    public int[] relativeSortArray(int[] arr1, int[] arr2) {
        int[] cnt = new int[1001];
        for(int n : arr1) cnt[n]++;
        int i = 0;
        for(int n : arr2) {
            while(cnt[n]-- > 0) {
                arr1[i++] = n;
            }
        }
        for(int n = 0; n < cnt.length; n++) {
            while(cnt[n]-- > 0) {
                arr1[i++] = n;
            }
        }
        return arr1;
    }
}
